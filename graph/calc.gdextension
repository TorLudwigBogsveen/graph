[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../calc/target/debug/libcalc.so"
linux.release.x86_64 =   "res://../calc/target/release/libcalc.so"
windows.debug.x86_64 =   "res://../calc/target/debug/calc.dll"
windows.release.x86_64 = "res://../calc/target/release/calc.dll"
macos.debug =            "res://../calc/target/debug/libcalc.dylib"
macos.release =          "res://../calc/target/release/libcalc.dylib"
macos.debug.arm64 =      "res://../calc/target/debug/libcalc.dylib"
macos.release.arm64 =    "res://../calc/target/release/libcalc.dylib"
